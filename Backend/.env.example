# Template for Backend/.env — copy to .env and fill in real values.
# Safe to commit; contains no secrets — put real values only in .env (git-ignored).

# Groq API key (https://console.groq.com). Required whenever NEXPLOY_AI_PROVIDER=llm.
# NOTE: the previously committed key here has been removed — rotate it in the Groq console
# and place the new key only in your local .env, never in this template.
GROQ_API_KEY=your-groq-api-key-here

# AI provider: "llm" (default) uses Groq; "rule-based" runs fully offline (no key needed).
NEXPLOY_AI_PROVIDER=llm

# Optional overrides (defaults live in application.yml):
# GROQ_BASE_URL=https://api.groq.com/openai
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE=0.1

# ----- Authentication: registration and password-reset email OTP -----
# Enabled by default. Configure the Gmail/Workspace App Password below to send OTP emails.
AUTH_OTP_ENABLED=true

# ----- Notifications: Email channel (Step 6) -----
# Notification emails are off by default; OTP emails use the separate AUTH_OTP_ENABLED switch.
NOTIFICATIONS_EMAIL_ENABLED=false
# Gmail/Workspace: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Host/port default to Gmail in application.yml.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# ----- Notifications: SMS channel (Step 7) -----
# Off by default. Set to true and fill Twilio creds to actually send SMS (critical events only).
NOTIFICATIONS_SMS_ENABLED=false
# From the Twilio console (https://console.twilio.com).
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Your Twilio sender number in E.164 format, e.g. +14155550123
TWILIO_FROM=+10000000000

# Dispatch cadence for the queued email/SMS sender (cron). Default: every minute.
# NOTIFICATIONS_DISPATCH_CRON=0 * * * * *
# Delivery hardening (Step 10) — rows per sweep, give-up threshold, and retry spacing.
# NOTIFICATIONS_DISPATCH_BATCH_SIZE=100
# NOTIFICATIONS_MAX_ATTEMPTS=3
# NOTIFICATIONS_RETRY_BACKOFF_SECONDS=300

# ----- Kafka: domain-event transport (optional) -----
# Off by default: domain events flow through the in-process Spring event bus. Set to true to route
# them through Kafka instead (producer bridge after commit -> consumer drives notifications). When
# on, start the broker with `docker compose up -d kafka` from the repo root first.
KAFKA_ENABLED=false
# Broker address; matches the docker-compose Kafka's host listener.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_DOMAIN_EVENTS_TOPIC=campuslink.domain-events
# KAFKA_CONSUMER_GROUP=campuslink-notifications

# ----- Security (override the checked-in defaults before any shared/prod deploy) -----
# The app logs a WARN at startup while these remain on their insecure defaults.
# JWT_SECRET must be at least 32 characters.
# JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
# DEMO_PASSWORD=replace-me
