# API_MODE selects where the src/lib/api/* domain functions resolve from.
#   mock (default) — resolve from src/data/mock; no network call.
#   live           — call the Spring Boot backend via src/lib/api/client.ts.
# Domains with a faithful backend mapping branch on this (eligibility;
# registration via /register — POST /api/auth/register + GET /api/campuses/public;
# per-student risk via GET /api/students/:id/risk/entries, latest entry;
# per-student intervention via GET /api/students/:id/interventions, latest plan);
# others stay on mock regardless until their backend DTOs are richer.
NEXT_PUBLIC_API_MODE=mock

# Spring Boot backend base URL. Every endpoint is served under /api on port 8080.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
